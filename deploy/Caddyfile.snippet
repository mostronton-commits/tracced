# Site block for the Caddy that owns ports 80/443 on the VPS. Replace DOMAIN, append to its Caddyfile,
# then reload without downtime:  docker exec <caddy container> caddy reload --config /etc/caddy/Caddyfile
DOMAIN {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
    reverse_proxy tracced-web:8095
}
