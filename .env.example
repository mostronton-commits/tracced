# Solana Tracker Data API key (required): https://www.solanatracker.io/data-api
SOLANATRACKER_API_KEY=
# Random string that signs the wallet sign-in cookies. Without it every restart signs everyone out.
# Make one with: openssl rand -hex 32
WEB_SECRET=
# Optional: the domain wallets sign in to, if the proxy rewrites the Host header (defaults to the request host)
WEB_DOMAIN=
# Optional: wallet addresses (comma-separated) that can open /admin — the usage dashboard (who connected, what they
# do, what each step costs) and the agent's method. These wallets are left out of the usage numbers by default
ADMIN_WALLETS=
# Optional: the AI agent (an OpenAI-compatible chat endpoint, OpenRouter by default). Without a key the result page
# shows no agent. OpenRouter: an *API key* (not a management key); give the key its own spending limit there.
# About $0.001 an answer with deepseek-v4.1-flash (checked 25.09.2026). Limits: agent_* in tracced/early/settings.py
# (override under early: in config.yaml). The owner writes the agent's method at /admin.
ASSISTANT_KEY=
ASSISTANT_URL=https://openrouter.ai/api/v1
ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash
# Optional: fallback models, comma-separated, tried when the main one is down
ASSISTANT_FALLBACKS=deepseek/deepseek-v4-flash
# Optional but recommended: a Solana RPC with FULL history, for wallet age and the first funder.
# Helius (free plan is enough) does both calls, and its oldest-first method finds a busy wallet's first
# transaction in one call: SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY and nothing else.
# Another node: SOLANA_RPC_URL walks getSignaturesForAddress, SOLANA_RPC_TX_URL reads the funder's getTransaction.
# Empty falls back to api.mainnet-beta.solana.com, which answers 429 on long series, so then only the first 200
# wallets by PnL are checked automatically.
SOLANA_RPC_URL=
SOLANA_RPC_TX_URL=
# VPS only: the Docker network of the Caddy container that owns ports 80/443 (docker network ls); default proxy
PROXY_NETWORK=
# Optional: WEB_PORT (default 8095), WEB_HOST (default 0.0.0.0), EARLY_CONFIG (path to the config file, default config.yaml)
# Optional: Umami Cloud analytics (https://umami.is); the id is public by design. It counts only on UMAMI_DOMAINS
# (default tracced.xyz,www.tracced.xyz), so a local run or the draft with the same id adds nothing.
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
